# Copy to .env and fill in real values. .env is git-ignored.

# Neon Postgres connection string (Dashboard → Connection Details).
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Random secret used to encrypt/sign the teacher session cookie.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=

# Mercado Pago (Painel do Mercado Pago → Suas integrações → Credenciais).
MERCADOPAGO_ACCESS_TOKEN=
# Chave secreta do webhook (Painel do Mercado Pago → Webhooks).
MERCADOPAGO_WEBHOOK_SECRET=

# URL pública do site — usada nos links de retorno/notificação enviados ao Mercado Pago
# e nos links dos e-mails (recuperação de senha, lembrete de mensalidade).
SITE_URL=https://seminario-huguenotes.vercel.app

# Resend (resend.com/api-keys) — envio de e-mail.
RESEND_API_KEY=
# Remetente dos e-mails — precisa de domínio verificado no Resend pra
# mandar pra qualquer destinatário (sem isso só funciona em modo teste).
EMAIL_FROM="Seminário Huguenotes <no-reply@seminariohuguenotes.com.br>"

# Segredo usado pra autenticar a chamada do cron diário de lembrete de
# mensalidade (Vercel → Settings → Cron Jobs já manda esse header sozinho
# se configurado; gere uma string aleatória e coloque nos dois lugares).
CRON_SECRET=

# Vercel Blob (Painel da Vercel → Storage → Create Database → Blob) —
# usado pra upload de arquivo da apostila e das entregas de tarefa.
BLOB_READ_WRITE_TOKEN=

# Notificações push (PWA instalado no celular) — par de chaves VAPID.
# Gere um par novo com um script que use Web Crypto (ECDSA P-256) — não dá
# pra usar a mesma chave de outro projeto, cada site precisa da sua.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# E-mail de contato mostrado aos serviços de push (Chrome/Firefox) caso
# precisem entrar em contato sobre o uso das notificações.
VAPID_SUBJECT=mailto:contato@example.com
