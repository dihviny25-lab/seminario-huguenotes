# Copy to .env and fill in real values. .env is git-ignored.

# Neon Postgres connection string (Dashboard → Connection Details).
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Random secret used to encrypt/sign the teacher session cookie.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=

# Mercado Pago (Painel do Mercado Pago → Suas integrações → Credenciais).
MERCADOPAGO_ACCESS_TOKEN=
# Chave secreta do webhook (Painel do Mercado Pago → Webhooks).
MERCADOPAGO_WEBHOOK_SECRET=

# URL pública do site — usada nos links de retorno/notificação enviados ao Mercado Pago.
SITE_URL=https://seminario-huguenotes.vercel.app
